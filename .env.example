# CruiseMode Environment Configuration
# Copy this to .env and fill in your values

# Gemini API key (optional for local demo — mock responses used if absent)
GOOGLE_API_KEY=
GEMINI_API_KEY=

# Google Cloud (optional — not required for local demo)
GCP_PROJECT_ID=
GCS_BUCKET_NAME=
BIGQUERY_DATASET=

# Jenkins (future integration)
JENKINS_URL=
JENKINS_TOKEN=

# GitHub (future integration)
GITHUB_TOKEN=
GITHUB_REPO=
