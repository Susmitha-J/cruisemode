# pyenv
#   For a library or package, you might want to ignore these files since the code is
#   intended to run in multiple environments; otherwise, check them in:
# .python-version

# pipenv
#   According to pypa/pipenv#1255, pipenv should generally not be tracked
#   but if you want to lock the packaging, check Pipfile.lock in.
# Pipfile.lock

# poetry
#   Similarly, Python projects using Poetry should submit poetry.lock.
# poetry.lock

# pdm
#   Similar to Pipfile.lock or poetry.lock, pdm.lock is ignored by default
# pdm.lock
#   pdm local configuration
.pdm-python
.pdm-build/

